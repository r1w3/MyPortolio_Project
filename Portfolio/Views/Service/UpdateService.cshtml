@model Service
@{
    ViewData["Title"] = "Hizmeti Güncelle";
    Layout = "~/Views/AdminLayout/Layout.cshtml";
}
<style>
    .edu-card {
        max-width: 700px;
        margin: 0 auto;
        border: none;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 4px 24px rgba(0, 0, 0, 0.08);
    }

        .edu-card .card-header {
            background: linear-gradient(135deg, #1f1f1f 0%, #3a3a3a 100%);
            border: none;
            padding: 1.1rem 1.5rem;
        }

            .edu-card .card-header h5 {
                color: #fff;
                margin: 0;
                font-weight: 600;
                letter-spacing: 0.3px;
            }

        .edu-card .card-body {
            padding: 2rem;
            background: #fff;
        }

    .field-group {
        margin-bottom: 1.4rem;
    }

        .field-group label {
            font-size: 0.85rem;
            font-weight: 600;
            color: #444;
            margin-bottom: 0.4rem;
            display: block;
        }

    .field-hint {
        font-size: 0.78rem;
        color: #999;
        margin-top: 0.4rem;
    }

        .field-hint a {
            color: #555;
            text-decoration: underline;
        }

    .input-group-text {
        background: #f8f8f8;
        border: 1.5px solid #e4e4e4;
        border-right: none;
        color: #888;
        border-radius: 10px 0 0 10px;
    }

    .icon-preview-box {
        width: 48px;
        height: 48px;
        border-radius: 10px 0 0 10px;
        background: #1f1f1f;
        color: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.2rem;
        flex-shrink: 0;
        border: 1.5px solid #1f1f1f;
        border-right: none;
    }

    .edu-card .form-control {
        border: 1.5px solid #e4e4e4;
        border-left: none;
        border-radius: 0 10px 10px 0;
        padding: 0.65rem 0.9rem;
        font-size: 0.95rem;
        transition: all 0.2s ease;
    }

    .edu-card textarea.form-control {
        border-left: 1.5px solid #e4e4e4;
        border-radius: 10px;
        resize: none;
    }

    .edu-card .form-control:focus {
        border-color: #1f1f1f;
        box-shadow: 0 0 0 3px rgba(31, 31, 31, 0.08);
        z-index: 0;
    }

    .input-group:focus-within .input-group-text {
        border-color: #1f1f1f;
    }

    .btn-save {
        background: #1f1f1f;
        color: #fff;
        border: none;
        border-radius: 10px;
        padding: 0.75rem;
        font-weight: 600;
        font-size: 0.95rem;
        letter-spacing: 0.3px;
        transition: all 0.2s ease;
    }

        .btn-save:hover {
            background: #000;
            transform: translateY(-1px);
            box-shadow: 0 6px 16px rgba(0, 0, 0, 0.2);
            color: #fff;
        }

    .page-title {
        font-weight: 700;
        color: #1f1f1f;
        margin-bottom: 1.5rem;
    }
</style>

<h3 class="page-title">Hizmeti Güncelle</h3>

<div class="card edu-card">
    <div class="card-header d-flex align-items-center gap-2">
        <i class="bi bi-pencil-square text-white"></i>
        <h5>Hizmeti Güncelle</h5>
    </div>

    <div class="card-body">
        <form method="post">

            <input type="hidden" asp-for="Id" />

            <div class="field-group">
                <label>İkon</label>
                <div class="input-group">
                    <span class="icon-preview-box"><i id="iconPreview" class="@Model.Icon"></i></span>
                    <input type="text" asp-for="Icon" id="iconInput" class="form-control" oninput="document.getElementById('iconPreview').className = this.value || 'bi bi-question-lg';" />
                </div>
                <div class="field-hint">
                    Bootstrap Icons class adını gir (ör: <code>bi-code-slash</code>, <code>bi-palette</code>, <code>bi-cloud</code>).
                    <a href="https://icons.getbootstrap.com" target="_blank">İkon listesine bak</a>
                </div>
                <span class="text-danger small" asp-validation-for="Icon"></span>
            </div>

            <div class="field-group">
                <label>Başlık</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-card-heading"></i></span>
                    <input type="text" asp-for="Title" class="form-control" />
                </div>
                <span class="text-danger small" asp-validation-for="Title"></span>
            </div>

            <div class="field-group">
                <label>Açıklama</label>
                <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                <span class="text-danger small" asp-validation-for="Description"></span>
            </div>

            <button type="submit" class="btn btn-save w-100 mt-2">
                <i class="bi bi-arrow-repeat me-1"></i> Güncelle
            </button>

        </form>
    </div>
</div>