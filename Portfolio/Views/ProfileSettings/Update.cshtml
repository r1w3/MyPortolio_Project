@model Admin
@{
    ViewData["Title"] = "Profili Düzenle";
    Layout = "~/Views/AdminLayout/Layout.cshtml";
}

<style>
    .edu-card {
        max-width: 700px;
        margin: 0 auto;
        border: none;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 4px 24px rgba(0, 0, 0, 0.08);
    }

        .edu-card .card-header {
            background: linear-gradient(135deg, #1f1f1f 0%, #3a3a3a 100%);
            border: none;
            padding: 1.1rem 1.5rem;
        }

            .edu-card .card-header h5 {
                color: #fff;
                margin: 0;
                font-weight: 600;
                letter-spacing: 0.3px;
            }

        .edu-card .card-body {
            padding: 2rem;
            background: #fff;
        }

    .field-group {
        margin-bottom: 1.4rem;
    }

        .field-group label {
            font-size: 0.85rem;
            font-weight: 600;
            color: #444;
            margin-bottom: 0.4rem;
            display: block;
        }

    .input-group-text {
        background: #f8f8f8;
        border: 1.5px solid #e4e4e4;
        border-right: none;
        color: #888;
        border-radius: 10px 0 0 10px;
    }

    .edu-card .form-control {
        border: 1.5px solid #e4e4e4;
        border-left: none;
        border-radius: 0 10px 10px 0;
        padding: 0.65rem 0.9rem;
        font-size: 0.95rem;
        transition: all 0.2s ease;
    }

        .edu-card .form-control:focus {
            border-color: #1f1f1f;
            box-shadow: 0 0 0 3px rgba(31, 31, 31, 0.08);
            z-index: 0;
        }

    .input-group:focus-within .input-group-text {
        border-color: #1f1f1f;
    }

    .section-divider {
        display: flex;
        align-items: center;
        gap: 10px;
        margin: 2rem 0 1.4rem;
    }

        .section-divider span {
            font-size: 0.8rem;
            font-weight: 700;
            color: #999;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            white-space: nowrap;
        }

        .section-divider::after {
            content: "";
            flex-grow: 1;
            height: 1px;
            background: #eee;
        }

    .password-toggle {
        position: relative;
    }

        .password-toggle .toggle-eye {
            position: absolute;
            right: 12px;
            top: 50%;
            transform: translateY(-50%);
            cursor: pointer;
            color: #999;
            font-size: 0.95rem;
        }

        .password-toggle input {
            padding-right: 42px !important;
        }

    .btn-save {
        background: #1f1f1f;
        color: #fff;
        border: none;
        border-radius: 10px;
        padding: 0.75rem;
        font-weight: 600;
        font-size: 0.95rem;
        letter-spacing: 0.3px;
        transition: all 0.2s ease;
    }

        .btn-save:hover {
            background: #000;
            transform: translateY(-1px);
            box-shadow: 0 6px 16px rgba(0, 0, 0, 0.2);
            color: #fff;
        }

    .page-title {
        font-weight: 700;
        color: #1f1f1f;
        margin-bottom: 1.5rem;
    }

    .hint-text {
        font-size: 0.78rem;
        color: #999;
        margin-top: 0.4rem;
    }

    #passwordMismatch {
        display: none;
        color: #dc3545;
        font-size: 0.8rem;
        margin-top: 0.3rem;
    }
</style>

<h3 class="page-title">Profili Düzenle</h3>

<div class="card edu-card">
    <div class="card-header d-flex align-items-center gap-2">
        <i class="bi bi-person-gear text-white"></i>
        <h5>Profil Bilgilerim</h5>
    </div>

    <div class="card-body">
        <form method="post" id="profileForm">

            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="ImageUrl" />

            <div class="field-group">
                <label>Kullanıcı Adı</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-person"></i></span>
                    <input type="text" asp-for="Username" class="form-control" placeholder="kullaniciadi" />
                </div>
                <span class="text-danger small" asp-validation-for="Username"></span>
            </div>

            <div class="field-group">
                <label>İsim Soyisim</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-card-heading"></i></span>
                    <input type="text" asp-for="Fullname" class="form-control" placeholder="Örn: Emir Turan" />
                </div>
                <span class="text-danger small" asp-validation-for="Fullname"></span>
            </div>

            <div class="section-divider">
                <span>Şifre Değiştir</span>
            </div>

            <div class="field-group">
                <label>Yeni Şifre</label>
                <div class="input-group password-toggle">
                    <span class="input-group-text"><i class="bi bi-key"></i></span>
                    <input type="password" asp-for="Password" id="newPassword" class="form-control" placeholder="••••••••" />
                    <i class="bi bi-eye toggle-eye" onclick="togglePassword('newPassword', this)"></i>
                </div>
                <div class="hint-text">Şifreni değiştirmek istemiyorsan bu alanları boş bırak.</div>
            </div>

            <div class="field-group">
                <label>Yeni Şifre (Tekrar)</label>
                <div class="input-group password-toggle">
                    <span class="input-group-text"><i class="bi bi-key-fill"></i></span>
                    <input type="password" id="confirmPassword" class="form-control" placeholder="••••••••" />
                    <i class="bi bi-eye toggle-eye" onclick="togglePassword('confirmPassword', this)"></i>
                </div>
                <div id="passwordMismatch">Şifreler eşleşmiyor.</div>
            </div>

            <button type="submit" class="btn btn-save w-100 mt-2">
                <i class="bi bi-check2-circle me-1"></i> Değişiklikleri Kaydet
            </button>

        </form>
    </div>
</div>

<script>

    function togglePassword(inputId, icon) {
        const input = document.getElementById(inputId);
        if (input.type === "password") {
            input.type = "text";
            icon.classList.remove("bi-eye");
            icon.classList.add("bi-eye-slash");
        } else {
            input.type = "password";
            icon.classList.remove("bi-eye-slash");
            icon.classList.add("bi-eye");
        }
    }

    document.getElementById("profileForm").addEventListener("submit", function (e) {
        const newPass = document.getElementById("newPassword").value;
        const confirmPass = document.getElementById("confirmPassword").value;
        const mismatchEl = document.getElementById("passwordMismatch");

        if (newPass !== confirmPass) {
            e.preventDefault();
            mismatchEl.style.display = "block";
        } else {
            mismatchEl.style.display = "none";
        }
    });

</script>