@model LoginViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link href="~/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" />
    <style>
            body{
                min-height: 100vh;
                display: flex;
                align-items: center;
                justify-content: center;
                font-family: sans-serif;
                background-color: #0d1117;
                background-image: url(https://images.unsplash.com/photo-1555066931-4365d14bab8c);
                background-size:cover;
                position: relative;
                overflow: hidden;
               }

            .login-card {
                background: #ffffff;
                border: 1px solid #e0dfd8;
                border-radius: 12px;
                padding: 2rem 2.5rem;
                width: 100%;
                max-width: 400px;
                position: relative;
                z-index: 1;
            }

                .login-card h1 {
                    font-size: 22px;
                    font-weight: 500;
                    color: #1a1a18;
                    margin-bottom: 0.25rem;
                }

                .login-card .subtitle {
                    font-size: 14px;
                    color: #6b6a65;
                    margin-bottom: 1.75rem;
                }

            .form-label {
                font-size: 13px;
                color: #6b6a65;
                margin-bottom: 5px;
            }

            .form-control {
                height: 36px;
                font-size: 14px;
                border: 1px solid #d3d1c7;
                border-radius: 8px;
                color: #1a1a18;
            }

                .form-control:focus {
                    border-color: #378add;
                    box-shadow: 0 0 0 3px rgba(55, 138, 221, 0.15);
                }

            .btn-login {
                width: 100%;
                padding: 10px;
                background: #378add;
                color: #ffffff;
                border: none;
                border-radius: 8px;
                font-size: 15px;
                font-weight: 500;
                cursor: pointer;
                margin-top: 0.5rem;
            }

                .btn-login:hover {
                    background: #185fa5;
                    color: #fff;
                }

            .text-danger {
                font-size: 12px;
            }
    </style>
</head>
<body>

    <div class="login-card">
        <h1>Giriş yap</h1>
        <p class="subtitle">Hesabına erişmek için bilgilerini gir.</p>

        <form method="post">
            <div class="mb-3">
                <label class="form-label">Kullanıcı adı</label>
                <input type="text" asp-for="UserName" class="form-control" placeholder="Kullanıcı Adı" />
                <span class="text-danger" asp-validation-for="UserName"></span>
            </div>

            <div class="mb-3">
                <label class="form-label">Şifre</label>
                <input type="password" asp-for="Password" class="form-control" placeholder="••••••••" />
                <span class="text-danger" asp-validation-for="Password"></span>
            </div>

            <span class="text-danger d-block mb-2">@Html.ValidationSummary(excludePropertyErrors: true)</span>

            <button class="btn-login">Giriş yap</button>
        </form>
    </div>

</body>
</html>