@model Education
@{
    ViewData["Title"] = "Yeni Eğitim Bilgisi Ekle";
    Layout = "~/Views/AdminLayout/Layout.cshtml";
}

<style>
    .edu-card {
        max-width: 700px;
        margin: 0 auto;
        border: none;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 4px 24px rgba(0, 0, 0, 0.08);
    }

        .edu-card .card-header {
            background: linear-gradient(135deg, #1f1f1f 0%, #3a3a3a 100%);
            border: none;
            padding: 1.1rem 1.5rem;
        }

            .edu-card .card-header h5 {
                color: #fff;
                margin: 0;
                font-weight: 600;
                letter-spacing: 0.3px;
            }

        .edu-card .card-body {
            padding: 2rem;
            background: #fff;
        }

    .field-group {
        margin-bottom: 1.4rem;
    }

        .field-group label {
            font-size: 0.85rem;
            font-weight: 600;
            color: #444;
            margin-bottom: 0.4rem;
            display: block;
        }

    .field-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1.2rem;
    }

    .input-group-text {
        background: #f8f8f8;
        border: 1.5px solid #e4e4e4;
        border-right: none;
        color: #888;
        border-radius: 10px 0 0 10px;
    }

    .edu-card .form-control {
        border: 1.5px solid #e4e4e4;
        border-left: none;
        border-radius: 0 10px 10px 0;
        padding: 0.65rem 0.9rem;
        font-size: 0.95rem;
        transition: all 0.2s ease;
    }

    .edu-card textarea.form-control {
        border-left: 1.5px solid #e4e4e4;
        border-radius: 10px;
        resize: none;
    }

    .edu-card .form-control:focus {
        border-color: #1f1f1f;
        box-shadow: 0 0 0 3px rgba(31, 31, 31, 0.08);
        z-index: 0;
    }

    .input-group:focus-within .input-group-text {
        border-color: #1f1f1f;
    }

    .btn-save {
        background: #1f1f1f;
        color: #fff;
        border: none;
        border-radius: 10px;
        padding: 0.75rem;
        font-weight: 600;
        font-size: 0.95rem;
        letter-spacing: 0.3px;
        transition: all 0.2s ease;
    }

        .btn-save:hover {
            background: #000;
            transform: translateY(-1px);
            box-shadow: 0 6px 16px rgba(0, 0, 0, 0.2);
            color: #fff;
        }

    .page-title {
        font-weight: 700;
        color: #1f1f1f;
        margin-bottom: 1.5rem;
    }

    @@media (max-width: 576px) {
        .field-row {
            grid-template-columns: 1fr;
        }
    }
</style>

<h3 class="page-title">Yeni Eğitim Bilgisi Ekle</h3>

<div class="card edu-card">
    <div class="card-header d-flex align-items-center gap-2">
        <i class="bi bi-mortarboard-fill text-white"></i>
        <h5>Yeni Eğitim Bilgisi Ekle</h5>
    </div>

    <div class="card-body">
        <form method="post">

            <div class="field-group">
                <label>Okul Adı</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-bank"></i></span>
                    <input type="text" asp-for="SchoolName" class="form-control" placeholder="Örn: İstanbul Teknik Üniversitesi" />
                </div>
                <span class="text-danger small" asp-validation-for="SchoolName"></span>
            </div>

            <div class="field-group">
                <label>Bölüm Adı</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-book"></i></span>
                    <input type="text" asp-for="Department" class="form-control" placeholder="Örn: Bilgisayar Mühendisliği" />
                </div>
                <span class="text-danger small" asp-validation-for="Department"></span>
            </div>

            <div class="field-group">
                <label>Açıklama</label>
                <textarea asp-for="Comment" class="form-control" rows="4" placeholder="Eğitim süreciyle ilgili kısa bir açıklama yazın..."></textarea>
                <span class="text-danger small" asp-validation-for="Comment"></span>
            </div>

            <div class="field-row">
                <div class="field-group">
                    <label>Ortalama</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-graph-up"></i></span>
                        <input type="number" step="0.01" min="0" max="4" asp-for="GPA" class="form-control" placeholder="Örn: 3.25" />
                    </div>
                    <span class="text-danger small" asp-validation-for="GPA"></span>
                </div>

                <div class="field-group">
                    <label>Başlangıç Yılı</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-calendar-event"></i></span>
                        <input type="number" min="1950" max="2100" asp-for="StartYear" class="form-control" placeholder="Örn: 2020" />
                    </div>
                    <span class="text-danger small" asp-validation-for="StartYear"></span>
                </div>
            </div>

            <div class="field-group">
                <label>Mezuniyet Yılı</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-calendar-check"></i></span>
                    <input type="number" min="1950" max="2100" asp-for="GraduationYear" class="form-control" placeholder="Örn: 2024" />
                </div>
                <span class="text-danger small" asp-validation-for="GraduationYear"></span>
            </div>

            <button type="submit" class="btn btn-save w-100 mt-2">
                <i class="bi bi-check2-circle me-1"></i> Kaydet
            </button>

        </form>
    </div>
</div>