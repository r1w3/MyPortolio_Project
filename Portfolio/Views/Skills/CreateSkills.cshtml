@model Skills
@{
    ViewData["Title"] = "Yeni Yetenek Ekle";
    Layout = "~/Views/AdminLayout/Layout.cshtml";
}

<style>
    .edu-card {
        max-width: 700px;
        margin: 0 auto;
        border: none;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 4px 24px rgba(0, 0, 0, 0.08);
    }

        .edu-card .card-header {
            background: linear-gradient(135deg, #1f1f1f 0%, #3a3a3a 100%);
            border: none;
            padding: 1.1rem 1.5rem;
        }

            .edu-card .card-header h5 {
                color: #fff;
                margin: 0;
                font-weight: 600;
                letter-spacing: 0.3px;
            }

        .edu-card .card-body {
            padding: 2rem;
            background: #fff;
        }

    .field-group {
        margin-bottom: 1.4rem;
    }

        .field-group label {
            font-size: 0.85rem;
            font-weight: 600;
            color: #444;
            margin-bottom: 0.4rem;
            display: block;
        }

    .input-group-text {
        background: #f8f8f8;
        border: 1.5px solid #e4e4e4;
        border-right: none;
        color: #888;
        border-radius: 10px 0 0 10px;
    }

    .edu-card .form-control {
        border: 1.5px solid #e4e4e4;
        border-left: none;
        border-radius: 0 10px 10px 0;
        padding: 0.65rem 0.9rem;
        font-size: 0.95rem;
        transition: all 0.2s ease;
    }

        .edu-card .form-control:focus {
            border-color: #1f1f1f;
            box-shadow: 0 0 0 3px rgba(31, 31, 31, 0.08);
            z-index: 0;
        }

    .input-group:focus-within .input-group-text {
        border-color: #1f1f1f;
    }

    .switch-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        background: #f8f8f8;
        border: 1.5px solid #e4e4e4;
        border-radius: 10px;
        padding: 0.85rem 1.1rem;
        margin-bottom: 1.6rem;
    }

    .switch-label {
        font-size: 0.9rem;
        font-weight: 600;
        color: #333;
    }

    .switch-sub {
        font-size: 0.78rem;
        color: #999;
        margin-top: 2px;
    }

    .form-check-input {
        width: 44px;
        height: 24px;
        cursor: pointer;
    }

        .form-check-input:checked {
            background-color: #1f1f1f;
            border-color: #1f1f1f;
        }

    .btn-save {
        background: #1f1f1f;
        color: #fff;
        border: none;
        border-radius: 10px;
        padding: 0.75rem;
        font-weight: 600;
        font-size: 0.95rem;
        letter-spacing: 0.3px;
        transition: all 0.2s ease;
    }

        .btn-save:hover {
            background: #000;
            transform: translateY(-1px);
            box-shadow: 0 6px 16px rgba(0, 0, 0, 0.2);
            color: #fff;
        }

    .page-title {
        font-weight: 700;
        color: #1f1f1f;
        margin-bottom: 1.5rem;
    }
</style>

<h3 class="page-title">Yeni Yetenek Ekle</h3>

<div class="card edu-card">
    <div class="card-header d-flex align-items-center gap-2">
        <i class="bi bi-stars text-white"></i>
        <h5>Yeni Yetenek Ekle</h5>
    </div>

    <div class="card-body">
        <form method="post">

            <div class="field-group">
                <label>Yetenek Adı</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-code-slash"></i></span>
                    <input type="text" asp-for="Name" class="form-control" placeholder="Örn: C#, React, Python" />
                </div>
                <span class="text-danger small" asp-validation-for="Name"></span>
            </div>

            <div class="switch-row">
                <div>
                    <div class="switch-label">Aktif olarak göster</div>
                    <div class="switch-sub">Kapalıysa bu yetenek portfolyoda görünmez.</div>
                </div>
                <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" role="switch" asp-for="IsActive" checked />
                </div>
            </div>

            <button type="submit" class="btn btn-save w-100 mt-2">
                <i class="bi bi-check2-circle me-1"></i> Kaydet
            </button>

        </form>
    </div>
</div>