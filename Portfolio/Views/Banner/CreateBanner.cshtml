@model Banner
@{
    ViewData["Title"] = "Yeni Banner Ekle";
    Layout = "~/Views/AdminLayout/Layout.cshtml";
}

<style>
    .edu-card {
        max-width: 700px;
        margin: 0 auto;
        border: none;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 4px 24px rgba(0, 0, 0, 0.08);
    }

        .edu-card .card-header {
            background: linear-gradient(135deg, #1f1f1f 0%, #3a3a3a 100%);
            border: none;
            padding: 1.1rem 1.5rem;
        }

            .edu-card .card-header h5 {
                color: #fff;
                margin: 0;
                font-weight: 600;
                letter-spacing: 0.3px;
            }

        .edu-card .card-body {
            padding: 2rem;
            background: #fff;
        }

    .field-group {
        margin-bottom: 1.4rem;
    }

        .field-group label {
            font-size: 0.85rem;
            font-weight: 600;
            color: #444;
            margin-bottom: 0.4rem;
            display: block;
        }

    .input-group-text {
        background: #f8f8f8;
        border: 1.5px solid #e4e4e4;
        border-right: none;
        color: #888;
        border-radius: 10px 0 0 10px;
    }

    .edu-card .form-control {
        border: 1.5px solid #e4e4e4;
        border-left: none;
        border-radius: 0 10px 10px 0;
        padding: 0.65rem 0.9rem;
        font-size: 0.95rem;
        transition: all 0.2s ease;
    }

    .edu-card textarea.form-control {
        border-left: 1.5px solid #e4e4e4;
        border-radius: 10px;
        resize: none;
    }

    .edu-card .form-control:focus {
        border-color: #1f1f1f;
        box-shadow: 0 0 0 3px rgba(31, 31, 31, 0.08);
        z-index: 0;
    }

    .input-group:focus-within .input-group-text {
        border-color: #1f1f1f;
    }

    .btn-save {
        background: #1f1f1f;
        color: #fff;
        border: none;
        border-radius: 10px;
        padding: 0.75rem;
        font-weight: 600;
        font-size: 0.95rem;
        letter-spacing: 0.3px;
        transition: all 0.2s ease;
    }

        .btn-save:hover {
            background: #000;
            transform: translateY(-1px);
            box-shadow: 0 6px 16px rgba(0, 0, 0, 0.2);
            color: #fff;
        }

    .page-title {
        font-weight: 700;
        color: #1f1f1f;
        margin-bottom: 1.5rem;
    }
</style>

<h3 class="page-title">Yeni Banner Ekle</h3>

<div class="card edu-card">
    <div class="card-header d-flex align-items-center gap-2">
        <i class="bi bi-image-fill text-white"></i>
        <h5>Yeni Banner Ekle</h5>
    </div>

    <div class="card-body">
        <form method="post">

            <div class="field-group">
                <label>Görsel Url</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-image"></i></span>
                    <input type="text" asp-for="ImageUrl" class="form-control" placeholder="https://..." />
                </div>
                <span class="text-danger small" asp-validation-for="ImageUrl"></span>
            </div>

            <div class="field-group">
                <label>Başlık</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-card-heading"></i></span>
                    <input type="text" asp-for="Title" class="form-control" placeholder="Örn: Yazılım Geliştiriciyim" />
                </div>
                <span class="text-danger small" asp-validation-for="Title"></span>
            </div>

            <div class="field-group">
                <label>Açıklama</label>
                <textarea asp-for="Comment" class="form-control" rows="4" placeholder="Banner altında görünecek kısa açıklama..."></textarea>
                <span class="text-danger small" asp-validation-for="Comment"></span>
            </div>

            <button type="submit" class="btn btn-save w-100 mt-2">
                <i class="bi bi-check2-circle me-1"></i> Kaydet
            </button>

        </form>
    </div>
</div>